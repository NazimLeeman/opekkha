# Supabase — create a project at https://supabase.com and paste values below.
# Never commit real secrets. Copy this file to .env.local for local development.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for scheduled jobs / admin operations. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# Cron / notification worker — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-string

# Email (Resend). Without these, letter-available jobs acknowledge without sending.
# https://resend.com — use a verified domain for EMAIL_FROM in production.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Opekkha <onboarding@resend.dev>

# Comma-separated admin emails for /admin/reports (or set app_metadata.role=admin).
ADMIN_EMAILS=

# Optional privacy-safe monitoring webhook (errors + analytics events, scrubbed).
# MONITORING_WEBHOOK_URL=
